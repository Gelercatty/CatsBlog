#!/usr/bin/env python3
"""Upload one image to the blog's external image-hosting repository."""

from __future__ import annotations

import argparse
import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote


DEFAULT_REPOSITORY = "https://github.com/Gelercatty/image-hosting.git"
DEFAULT_PUBLIC_BASE = "https://images.geler.org"
SUPPORTED_EXTENSIONS = {".avif", ".gif", ".jpeg", ".jpg", ".png", ".svg", ".webp"}


def run(command: list[str], cwd: Path | None = None) -> str:
    result = subprocess.run(
        command,
        cwd=cwd,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return result.stdout.strip()


def public_url(base: str, relative_path: Path) -> str:
    encoded_path = "/".join(quote(part) for part in relative_path.parts)
    return f"{base.rstrip('/')}/{encoded_path}"


def main() -> int:
    parser = argparse.ArgumentParser(description="Upload an image and print its public URL.")
    parser.add_argument("--path", required=True, help="Path to the local image")
    args = parser.parse_args()

    source = Path(args.path).expanduser().resolve()
    if not source.is_file():
        parser.error(f"image does not exist: {source}")

    extension = source.suffix.lower()
    if extension not in SUPPORTED_EXTENSIONS:
        parser.error(f"unsupported image type: {extension or '(none)'}")

    repository_root = Path(__file__).resolve().parent.parent
    cache = Path(
        os.environ.get("CATSBLOG_IMAGE_CACHE", repository_root / ".image-hosting-cache")
    ).expanduser()
    repository = os.environ.get("CATSBLOG_IMAGE_REPO", DEFAULT_REPOSITORY)
    base_url = os.environ.get("CATSBLOG_IMAGE_BASE", DEFAULT_PUBLIC_BASE)

    if (cache / ".git").is_dir():
        run(["git", "pull", "--ff-only"], cwd=cache)
    elif cache.exists():
        raise RuntimeError(f"cache exists but is not a Git repository: {cache}")
    else:
        cache.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", "--depth", "1", repository, str(cache)])

    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    relative_path = Path("blog") / digest[:2] / f"{digest[:20]}{extension}"
    destination = cache / relative_path
    destination.parent.mkdir(parents=True, exist_ok=True)

    if not destination.exists():
        shutil.copy2(source, destination)
        run(["git", "add", "--", relative_path.as_posix()], cwd=cache)
        run(["git", "commit", "-m", f"Add blog image {digest[:12]}"], cwd=cache)
        run(["git", "push", "origin", "HEAD"], cwd=cache)

    print(public_url(base_url, relative_path))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        if error.stderr:
            print(error.stderr.strip(), file=sys.stderr)
        raise SystemExit(error.returncode)
    except RuntimeError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
